{
  "name": "docsync",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && node --experimental-strip-types scripts/dev.ts",
    "start": "node --experimental-strip-types scripts/dev.ts",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-test-isolation=none --test test/*.test.ts && npm run test:stdio",
    "test:browser": "node --experimental-strip-types test/browser.ts",
    "mcp": "node dist/docsync-mcp.cjs",
    "setup": "node --experimental-strip-types scripts/setup.mjs",
    "backup": "node --experimental-strip-types scripts/backup.ts",
    "restore-backup": "node --experimental-strip-types scripts/restore-backup.ts",
    "test:stdio": "sh test/mcp-stdio.sh && DOCSYNC_TEST_BUNDLE=1 sh test/mcp-stdio.sh",
    "pretest": "npm run build",
    "mcp:configure": "node --experimental-strip-types scripts/connect.mjs",
    "dev:ui": "vite",
    "pack:mcp": "npm run build && npm pack ./packages/mcp --ignore-scripts --pack-destination dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-table-cell": "^3.31.4",
    "@tiptap/extension-table-header": "^3.31.4",
    "@tiptap/extension-table-row": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "css-tree": "2.3.1",
    "parse5": "7.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "0.28.2",
    "lucide-react": "^1.56.0",
    "puppeteer-core": "^25.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.3.4"
  }
}
